{
  "name": "@openmost/nuxt-matomo",
  "version": "3.0.0",
  "description": "Matomo Tag Manager for Nuxt, powered by Nuxt Scripts",
  "repository": "openmost/nuxt-matomo",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "release": "npm run lint && npm run test && npm run prepack && changelogen --release && npm publish && git push --follow-tags",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit"
  },
  "dependencies": {
    "@nuxt/kit": "^4.6.2",
    "@nuxt/scripts": "^1.3.12 || ^2.0.0",
    "defu": "^6.1.4",
    "ufo": "^1.6.4",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.4.4",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.6.2",
    "@nuxt/test-utils": "^4.3.4",
    "@types/node": "^26.6.5",
    "changelogen": "^0.6.2",
    "eslint": "^9.39.5",
    "nuxt": "^4.6.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "nuxt",
    "nuxt-module",
    "matomo",
    "matomo-tag-manager",
    "analytics",
    "nuxt-scripts"
  ]
}
